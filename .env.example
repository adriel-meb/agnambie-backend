# Bible Brain API
BIBLE_BRAIN_API_KEY=your-api-key-here
BIBLE_BRAIN_BASE_URL=https://4.dbt.io/api

# Server
PORT=8080
ENV=development

# Redis (optional — if unset, an in-memory cache is used)
# REDIS_URL=redis://localhost:6379

# CORS (comma-separated origins; * for development)
CORS_ALLOWED_ORIGINS=*

# Logging: debug, info, warn, error
LOG_LEVEL=info